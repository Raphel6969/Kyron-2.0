# Kyron 2.0 Environment Configuration
# Copy to .env for local development

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gateway Configuration (Go Data Plane)
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_MODE=monitor
DECISION_CORE_SOCKET=tcp://127.0.0.1:50051

# Control Plane API Configuration (FastAPI)
CONTROL_API_PORT=8001
CONTROL_API_HOST=0.0.0.0
SECRET_KEY=kyron-insecure-development-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Version 16+)
DATABASE_URL=postgresql://kyron:kyron_secret@localhost:5432/kyron_db
POSTGRES_USER=kyron
POSTGRES_PASSWORD=kyron_secret
POSTGRES_DB=kyron_db
POSTGRES_PORT=5432

# Cryptographic Signing (Ed25519)
# Generate with: openssl genpkey -algorithm ed25519 -out ed25519_private.pem
ED25519_PRIVATE_KEY_HEX=9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60
ED25519_PUBLIC_KEY_HEX=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a

# Egress & Secrets Broker Rules
DEFAULT_EGRESS_BYTES_PER_TRAJECTORY=524288
DEFAULT_EGRESS_MAX_DISTINCT_REQUESTS=40
SECRETS_INJECT_MODE=gateway
SECRETS_TOKEN_TTL_SECONDS=120

# Feature Flags & Circuit Breakers
ENABLE_REMOTE_MCP=true
ENABLE_OFFLINE_JUDGE=false
ENABLE_EBPF_TRACING=false
ENABLE_OTEL_EXPORT=true
