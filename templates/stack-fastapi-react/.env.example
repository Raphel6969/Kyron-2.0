# Hack Engine — Environment Variables Template
# Copy to .env. Never track .env in version control.

ENVIRONMENT=development
PORT=8000

# Primary Relational Store (PostgreSQL required; SQLite banned for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/app_db

# LLM Inference Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Circuit Breaker Feature Flags (Demo Resilience)
ENABLE_EXTERNAL_API=true
ENABLE_LLM_INFERENCE=true

# Security & Session Authentication
JWT_SECRET=replace-with-a-random-32-character-secret-key-here
JWT_ALGORITHM=HS256
